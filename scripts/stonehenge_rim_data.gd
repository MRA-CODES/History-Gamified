static func get_boundary_at_angle(angle_rad: float) -> Vector2:
	var a = fposmod(angle_rad + PI, TAU) - PI
	var norm = (a + PI) / TAU
	var idx_float = norm * float(NUM_SECTORS)
	var idx0 = int(idx_float) % NUM_SECTORS
	var idx1 = (idx0 + 1) % NUM_SECTORS
	var frac = idx_float - float(int(idx_float))
	
	var r = lerpf(RIM_RADII[idx0], RIM_RADII[idx1], frac)
	var y = lerpf(RIM_ELEVATIONS[idx0], RIM_ELEVATIONS[idx1], frac)
	return Vector2(r, y)
