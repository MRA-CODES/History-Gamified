text = "ABOUT EXPLORE HISTORY"
horizontal_alignment = 1

[node name="Body" type="Label" parent="AboutModal/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.88, 0.92, 1)
theme_override_font_sizes/font_size = 14
text = "Explore History is an interactive virtual museum and historical adventure experience built in Godot Engine.

Step into architectural wonders across history with photogrammetry environments and third-person exploration.

Map 01 features London's iconic Victorian Natural History Museum and Hintze Hall."
autowrap_mode = 2

